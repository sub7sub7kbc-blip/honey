# API (api/.env) — never commit real values. Set these in Render > goldenhive-api > Environment.
DATABASE_URL=postgresql://user:password@host:5432/neondb?sslmode=require
JWT_SECRET=change-this-to-a-long-random-string
PORT=3001

# Frontend (web/.env) — set in Render > goldenhive-web > Environment, or leave
# empty for local dev (Vite proxies /api to localhost:3001).
VITE_API_URL=http://localhost:3001
